@baseUrl = http://localhost:3000

### PostgreSQL schema introspection
POST {{baseUrl}}/api/schema/introspect
Content-Type: application/json

{
  "dbType": "postgres",
  "connectionString": "postgresql://postgres:postgres@localhost:5432/demo"
}

### SQL Server schema introspection
POST {{baseUrl}}/api/schema/introspect
Content-Type: application/json

{
  "dbType": "sqlserver",
  "connectionString": "Server=localhost,1433;Database=demo;User Id=sa;Password=YourStrongPassword123!;TrustServerCertificate=True;Encrypt=False"
}

### MySQL schema introspection
POST {{baseUrl}}/api/schema/introspect
Content-Type: application/json

{
  "dbType": "mysql",
  "connectionString": "mysql://root:mysql@localhost:3306/demo"
}
